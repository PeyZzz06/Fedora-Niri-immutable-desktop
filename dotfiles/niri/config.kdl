input {
    keyboard {
        xkb {
            layout "latam"
        }
    }
    touchpad {
        tap
        natural-scroll
    }
}

layout {
    gaps 12
    center-focused-column "never"
    background-color "transparent"

    focus-ring {
        width 3                   
        active-color "#74c7ec"    
        inactive-color "#313244"  
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#00000060"
    }
}

binds {
    // --- Lanzadores de aplicaciones ---
    Mod+T { spawn "kitty"; }
    Mod+E { spawn-sh "kitty elio"; }
    Mod+B { spawn "firefox"; }

// --- Control de Volumen ---
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }

    // --- Control de Brillo ---
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "brightnessctl --class=backlight set +5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "brightnessctl --class=backlight set 5%-"; }
    // --- ATAJO CORREGIDO PARA EL MENÚ DE NOCTALIA ---
    Mod+D { spawn-sh "noctalia msg panel-toggle launcher"; }

    // --- Vista general (Overview) ---
    Mod+O { toggle-overview; }

    // --- Capturas de pantalla ---
    Mod+Shift+S { screenshot; }
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // --- Control de ventanas ---
    Mod+Q { close-window; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Shift+E { quit; }

    // --- Navegación ---
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }

    // --- Mover ventanas ---
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    // --- Workspaces ---
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }

    // --- Redimensionar columnas ---
    Mod+R { switch-preset-column-width; }
}

// --- Reglas de ventanas ---
window-rule {
    match app-id="org.gnome.Calculator"
    open-floating true
}

window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
}

// --- Integración con Noctalia ---
spawn-at-startup "noctalia"

layer-rule {
    match namespace="^noctalia-wallpaper*"
    place-within-backdrop true
}

overview {
    workspace-shadow {
        off
    }
}

debug {
    honor-xdg-activation-with-invalid-serial
}


include "noctalia.kdl"
